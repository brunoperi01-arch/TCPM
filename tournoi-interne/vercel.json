{
  "rewrites": [
    { "source": "/tournoi-interne/admin/api/:path*", "destination": "/api/admin/:path*" }
  ],
  "headers": [
    {
      "source": "/tournoi-interne/gestion.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
